---
import Icon from './Icon.astro';
import Lemon from './Lemon.astro';
import { url, formatUpdated } from '../lib/utils';
import { club, secciones } from '../data/club';
import { futbol } from '../lib/data';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__top container">
    <div class="footer__cta" data-reveal>
      <p class="eyebrow">Síguenos</p>
      <h2 class="title-lg">Únete a la<br /><span class="text-lemon">manada verde</span></h2>
    </div>
    <div class="footer__socials" data-reveal>
      {
        Object.values(secciones).map((s) => (
          <a class="social glass" href={s.instagram.instagram} target="_blank" rel="noopener">
            <img src={url(s.escudo)} alt="" width="56" height="56" loading="lazy" />
            <span>
              <small>{s.deporte}</small>
              {s.instagram.handle}
            </span>
            <Icon name="instagram" size={22} class="social__ig" />
          </a>
        ))
      }
    </div>
  </div>

  <div class="footer__grid container">
    <div>
      <h3>Club</h3>
      <a href={url('')}>Inicio</a>
      <a href={url('historia')}>Historia</a>
    </div>
    <div>
      <h3>Equipos</h3>
      <a href={url('futbol')}>Lagarto Limón FC</a>
      <a href={url('baloncesto')}>Lagarto Limón CB</a>
    </div>
    <div>
      <h3>Competiciones</h3>
      <a href={secciones.futbol.ligaUrl} target="_blank" rel="noopener">MálagaF7 <Icon name="external" size={14} /></a>
      <a href={secciones.baloncesto.ligaUrl} target="_blank" rel="noopener">Liga AFADE <Icon name="external" size={14} /></a>
    </div>
    <div>
      <h3>Instagram</h3>
      <a href={club.redes.futbol.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={15} /> {club.redes.futbol.handle}</a>
      <a href={club.redes.baloncesto.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={15} /> {club.redes.baloncesto.handle}</a>
    </div>
    <div>
      <h3>Datos</h3>
      <p>Resultados y calendarios sincronizados automáticamente con las ligas.</p>
      <p class="dim">Última actualización: {formatUpdated(futbol.updatedAt)}</p>
    </div>
  </div>

  <div class="footer__giant" aria-hidden="true">
    <span>Lagarto</span>
    <Lemon class="footer__lemon" />
    <span>Limón</span>
  </div>

  <div class="footer__bottom container">
    <p>© {year} {club.nombre} · {club.ciudad} · Desde {club.fundacion}</p>
    <p class="dim">{club.lema}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding-top: clamp(80px, 10vw, 140px);
    background: linear-gradient(180deg, transparent, rgba(5, 14, 7, 0.9) 30%);
    border-top: 1px solid var(--border);
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: end;
  }
  .footer__cta {
    display: grid;
    gap: 18px;
  }
  .footer__socials {
    display: grid;
    gap: 14px;
  }
  .social {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px 14px 14px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    transition: transform 0.5s var(--ease-out), border-color 0.3s, background 0.3s;
  }
  .social img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    transition: transform 0.6s var(--ease-out);
  }
  .social span {
    display: grid;
    line-height: 1.05;
  }
  .social small {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--text-dim);
  }
  .social :global(.social__ig) {
    margin-left: auto;
    color: var(--lemon);
  }
  .social:hover {
    transform: translateX(8px);
    border-color: rgba(255, 214, 10, 0.5);
  }
  .social:hover img {
    transform: rotate(-12deg) scale(1.08);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr) 1.4fr;
    gap: 32px;
    margin-top: clamp(64px, 8vw, 110px);
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  .footer__grid div {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .footer__grid h3 {
    font-size: 1.1rem;
    letter-spacing: 0.14em;
    color: var(--lemon);
    margin-bottom: 4px;
  }
  .footer__grid a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    width: fit-content;
    transition: color 0.25s;
  }
  .footer__grid a:hover {
    color: var(--cream);
  }
  .footer__grid p {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .dim {
    color: var(--text-dim) !important;
  }

  .footer__giant {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5vw;
    margin-top: clamp(48px, 7vw, 90px);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 15.5vw;
    line-height: 0.8;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 249, 232, 0.16);
    user-select: none;
  }
  .footer__giant :global(.footer__lemon) {
    width: 11vw;
    height: 11vw;
    flex: none;
    animation: spin 18s linear infinite;
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 28px 32px;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
    .social {
      font-size: 1.2rem;
    }
  }
</style>
