---
import TeamLogo from './TeamLogo.astro';
import Icon from './Icon.astro';
import type { Match } from '../lib/data';
import { dateBits, outcome, url } from '../lib/utils';
import { secciones } from '../data/club';

interface Props {
  match: Match;
  sport: 'futbol' | 'baloncesto';
  showSport?: boolean; // etiqueta FC/CB y competición
}
const { match: m, sport, showSport = false } = Astro.props;
const d = dateBits(m.date);
const res = outcome(m);
const ourCrest = url(secciones[sport].escudo);
const logoOf = (s: Match['home']) => (s.us ? ourCrest : s.logo);
const resLabel = { W: 'Victoria', D: 'Empate', L: 'Derrota' } as const;
const Tag = m.url ? 'a' : 'div';
---

<Tag
  class:list={['mrow', res && `res-${res}`, { 'is-bye': m.bye, 'is-played': m.played }]}
  href={m.url}
  target={m.url ? '_blank' : undefined}
  rel={m.url ? 'noopener' : undefined}
  data-reveal
>
  <div class="mrow__date">
    {d ? (
      <>
        <span class="mrow__dow">{d.dow}</span>
        <span class="mrow__day">{d.day}</span>
        <span class="mrow__month">{d.month}</span>
      </>
    ) : (
      <span class="mrow__tbd">{m.bye ? '—' : 'Por fijar'}</span>
    )}
  </div>

  <div class="mrow__body">
    <div class="mrow__meta">
      {showSport && (
        <span class="mrow__sport">
          <Icon name={sport === 'futbol' ? 'ball' : 'basket'} size={12} />
          {secciones[sport].corto}
        </span>
      )}
      {showSport && m.competition && <span class="mrow__comp">{m.competition}</span>}
      <span class="mrow__round">{m.round}</span>
      {m.knockout && <span class="mrow__ko">{m.stage}</span>}
      {m.venue && (
        <span class="mrow__venue">
          <Icon name="pin" size={13} />
          {m.venue}
        </span>
      )}
    </div>

    {m.bye ? (
      <div class="mrow__bye">Jornada de descanso</div>
    ) : (
      <div class="mrow__teams">
        <div class:list={['mrow__team mrow__team--home', { 'is-us': m.home.us }]}>
          <span class="mrow__name">{m.home.name}</span>
          <TeamLogo name={m.home.name} logo={logoOf(m.home)} size={40} />
        </div>
        <div class="mrow__score">
          {m.played && m.score ? (
            <>
              <b class:list={['mrow__hs', { 'is-us': m.isHome }]}>{m.score[0]}</b>
              <i>-</i>
              <b class:list={['mrow__as', { 'is-us': !m.isHome }]}>{m.score[1]}</b>
            </>
          ) : (
            <span class="mrow__time">{d?.time ?? 'vs'}</span>
          )}
          {m.shootout && (
            <small class="mrow__pens">
              pen. {m.shootout[0]}-{m.shootout[1]}
            </small>
          )}
        </div>
        <div class:list={['mrow__team mrow__team--away', { 'is-us': m.away.us }]}>
          <TeamLogo name={m.away.name} logo={logoOf(m.away)} size={40} />
          <span class="mrow__name">{m.away.name}</span>
        </div>
      </div>
    )}
  </div>

  <div class="mrow__res">
    {res && (
      <span class:list={['pill', `pill--${res}`]} title={resLabel[res]}>
        {res === 'W' ? 'V' : res === 'D' ? 'E' : 'D'}
      </span>
    )}
    {!res && !m.bye && <span class="pill pill--next">{m.isHome ? 'Casa' : 'Fuera'}</span>}
  </div>
</Tag>

<style>
  .mrow {
    display: grid;
    grid-template-columns: 74px 1fr 64px;
    align-items: center;
    gap: 18px;
    padding: 16px 20px 16px 16px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    transition:
      background 0.3s,
      border-color 0.3s,
      transform 0.5s var(--ease-out);
  }
  a.mrow:hover {
    background: var(--surface-2);
    border-color: color-mix(in srgb, var(--team) 55%, transparent);
    transform: translateX(6px);
  }
  .mrow.is-bye {
    opacity: 0.55;
  }

  .mrow__date {
    display: grid;
    justify-items: center;
    padding: 8px 0;
    border-radius: 12px;
    background: var(--jungle-950);
    border: 1px solid var(--border);
    line-height: 1;
    font-family: var(--font-display);
    text-transform: uppercase;
  }
  .is-played .mrow__date {
    opacity: 0.75;
  }
  .mrow__dow,
  .mrow__month {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .mrow__day {
    font-size: 2rem;
    font-weight: 900;
    color: var(--cream);
    margin: 2px 0;
  }
  .mrow__tbd {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text-dim);
    padding: 12px 4px;
    text-align: center;
  }

  .mrow__body {
    display: grid;
    gap: 10px;
    min-width: 0;
  }
  .mrow__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .mrow__round {
    color: var(--team);
  }
  .mrow__ko {
    color: var(--lemon);
  }
  .mrow__venue {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
  }
  .mrow__bye {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .mrow__teams {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 14px;
  }
  .mrow__team {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .mrow__team--home {
    justify-content: flex-end;
    text-align: right;
  }
  .mrow__name {
    font-weight: 700;
    font-size: 0.98rem;
    line-height: 1.2;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .is-us .mrow__name {
    color: var(--cream);
    font-weight: 800;
  }

  .mrow__score {
    display: grid;
    grid-auto-flow: column;
    align-items: center;
    justify-items: center;
    gap: 8px;
    min-width: 92px;
    padding: 6px 12px;
    border-radius: 10px;
    background: var(--jungle-950);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.7rem;
    line-height: 1;
    position: relative;
  }
  .mrow__score i {
    font-style: normal;
    color: var(--text-dim);
  }
  .mrow__time {
    font-size: 1.35rem;
    color: var(--lemon);
  }
  .mrow__pens {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 4px;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .mrow__res {
    display: flex;
    justify-content: flex-end;
  }
  .pill {
    display: grid;
    place-items: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.1rem;
    text-transform: uppercase;
  }
  .pill--W {
    background: var(--lizard);
    color: var(--jungle-950);
  }
  .pill--D {
    background: var(--lemon);
    color: var(--jungle-950);
  }
  .pill--L {
    background: var(--red);
    color: var(--cream);
  }
  .pill--next {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
  }

  @media (max-width: 720px) {
    .mrow {
      grid-template-columns: 58px 1fr;
      gap: 12px;
      padding: 14px;
    }
    .mrow__res {
      display: none;
    }
    .mrow__day {
      font-size: 1.6rem;
    }
    /* marcador en dos filas, una por equipo */
    .mrow__teams {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'home hs' 'away as' 'pens pens';
      gap: 8px 12px;
    }
    .mrow__team--home {
      grid-area: home;
      flex-direction: row-reverse;
      justify-content: flex-end;
      text-align: left;
    }
    .mrow__team--away {
      grid-area: away;
    }
    .mrow__score {
      display: contents;
    }
    .mrow__score i {
      display: none;
    }
    .mrow__hs,
    .mrow__as {
      display: grid;
      place-items: center;
      min-width: 34px;
      height: 32px;
      padding: 0 8px;
      border-radius: 8px;
      background: var(--jungle-950);
      font-family: var(--font-display);
      font-weight: 900;
      font-size: 1.3rem;
    }
    .mrow__hs {
      grid-area: hs;
    }
    .mrow__as {
      grid-area: as;
    }
    .res-W b.is-us {
      background: var(--lizard);
      color: var(--jungle-950);
    }
    .res-D b.is-us {
      background: var(--lemon);
      color: var(--jungle-950);
    }
    .res-L b.is-us {
      background: var(--red);
    }
    .mrow__time {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
      padding: 6px 10px;
      border-radius: 8px;
      background: var(--jungle-950);
      font-family: var(--font-display);
      font-weight: 900;
      font-size: 1.2rem;
    }
    .mrow__pens {
      grid-area: pens;
      position: static;
      translate: none;
      justify-self: end;
    }
    .mrow__name {
      font-size: 0.92rem;
    }
    .mrow :global(.tlogo) {
      --s: 30px !important;
    }
  }
  .mrow__sport {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--team);
    color: var(--jungle-950);
    font-weight: 800;
  }
  .mrow__comp {
    color: var(--text-muted);
  }
</style>
